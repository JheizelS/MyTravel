[gd_scene format=3 uid="uid://c51jc3brdd2tu"]

[sub_resource type="GDScript" id="GDScript_men84"]
script/source = "extends HSlider

func _ready() -> void:
	min_value = 0.1
	max_value = 3.0
	step = 0.1
	value = MouseSettings.sensitivity
	value_changed.connect(_on_sensitivity_changed)

func _on_sensitivity_changed(new_value: float) -> void:
	MouseSettings.sensitivity = new_value
"

